# Copy this file to ".env" and fill in your own values. Never commit ".env".

# URL where the RetailSync frontend is running
BASE_URL=http://localhost:5173

# Super admin account used to log in
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-admin-password

# MongoDB ObjectIds that exist in your test database
EMPLOYEE_ROLE_ID=24-character-id-of-the-EMPLOYEE-role
BRANCH_ID=24-character-id-of-a-branch

# (Optional) an email that already exists, used by the duplicate-email test
EXISTING_USER_EMAIL=an-existing-user@example.com
